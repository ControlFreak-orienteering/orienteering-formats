{
  "name": "orienteering-formats",
  "version": "0.21.0",
  "description": "Shared file formats for the ControlFreak family (.cfpack, .cfproj), readers for IOF XML CourseData and Purple Pen course files, an IOF XML StartList reader and writer, the QR course link for virtual controls, the ControlFreak Live protocol for live results sites and live punches from ControlFreak Run, competitions made on ControlFreak Live from QR codes, and a reader that draws OCAD and OpenOrienteering Mapper maps as SVG.",
  "license": "MIT",
  "author": "Henrik Flordal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ControlFreak-orienteering/orienteering-formats.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "import": "./dist/map/index.js"
    },
    "./map-testing": {
      "types": "./dist/map/testing/ocd-builder.d.ts",
      "import": "./dist/map/testing/ocd-builder.js"
    },
    "./qr": {
      "types": "./dist/qr.d.ts",
      "import": "./dist/qr.js"
    },
    "./run": {
      "types": "./dist/run/index.d.ts",
      "import": "./dist/run/index.js"
    },
    "./iof": {
      "types": "./dist/iof/index.d.ts",
      "import": "./dist/iof/index.js"
    },
    "./cf-live": {
      "types": "./dist/cf-live.d.ts",
      "import": "./dist/cf-live.js"
    },
    "./run-live": {
      "types": "./dist/run-live.d.ts",
      "import": "./dist/run-live.js"
    },
    "./live-competition": {
      "types": "./dist/live-competition.d.ts",
      "import": "./dist/live-competition.js"
    },
    "./purple-pen": {
      "types": "./dist/purple-pen/index.d.ts",
      "import": "./dist/purple-pen/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.mjs\" && vitest run"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  }
}
