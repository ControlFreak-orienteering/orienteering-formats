{
  "name": "orienteering-formats",
  "version": "0.6.2",
  "description": "Shared file formats for ControlFreak and CompetitionFreak (.cfpack, .cfproj), the QR course link for virtual controls, and a reader that draws OCAD and OpenOrienteering Mapper maps as SVG.",
  "license": "MIT",
  "author": "Henrik Flordal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenrikF/orienteering-formats.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "import": "./dist/map/index.js"
    },
    "./map-testing": {
      "types": "./dist/map/testing/ocd-builder.d.ts",
      "import": "./dist/map/testing/ocd-builder.js"
    },
    "./qr": {
      "types": "./dist/qr.d.ts",
      "import": "./dist/qr.js"
    },
    "./run": {
      "types": "./dist/run/index.d.ts",
      "import": "./dist/run/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.mjs\" && vitest run"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  }
}
